#!/bin/bash

{{- $relPath := "dot_config/system-configs/network-manager/NetworkManager.conf" }}
{{- $networkConf := joinPath .chezmoi.sourceDir $relPath }}
{{- $wifiRelPath := "dot_config/system-configs/network-manager/wifi_backend.conf" }}
{{- $wifiConf := joinPath .chezmoi.sourceDir $wifiRelPath }}

{{- if stat $networkConf }}
# network_conf_hash: {{ include $relPath | sha256sum }}
{{- else }}
# network_conf_hash: EMPTY_FILE_NO_HASH
{{- end }}

{{- if stat $wifiConf }}
# wifi_backend_hash: {{ include $wifiRelPath | sha256sum }}
{{- else }}
# wifi_backend_hash: EMPTY_FILE_NO_HASH
{{- end }}

sudo mkdir -p /etc/NetworkManager/conf.d

{{- if stat $networkConf }}
sudo cp {{ $networkConf }} /etc/NetworkManager/NetworkManager.conf
{{- else }}
if [ -f /etc/NetworkManager/NetworkManager.conf ]; then
    sudo rm /etc/NetworkManager/NetworkManager.conf
fi
{{- end }}

{{- if stat $wifiConf }}
sudo cp {{ $wifiConf }} /etc/NetworkManager/conf.d/wifi_backend.conf
{{- else }}
if [ -f /etc/NetworkManager/conf.d/wifi_backend.conf ]; then
    sudo rm /etc/NetworkManager/conf.d/wifi_backend.conf
fi
{{- end }}

sudo systemctl restart NetworkManager
echo "[v] Hoàn tất nạp cấu hình và khởi động lại NetworkManager (iwd backend)!"
