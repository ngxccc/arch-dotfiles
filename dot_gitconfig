[user]
	name = ngxc
	email = ngoc.shintrann@gmail.com
	signingkey = /home/ngxc/.ssh/ngxc.pub
[alias]
	st = status
	sw = switch
	br = branch
	up = rebase
	ci = commit
	pu = push
	s = status --short
	d = diff
	ds = diff --staged
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[gpg]
	format = ssh
[init]
	defaultBranch = main
[credential]
	helper = store
[pull]
	rebase = true
[core]
  excludesfile = /home/ngxc/.gitignore_global
	autocrlf = false
	eol = lf
  editor = nvim
[fetch]
	prune = true
[difftool]
	prompt = false
[push]
	autoSetupRemote = true
[status]
	showUntrackedFiles = all
[merge]
  conflictstyle = zdiff3
