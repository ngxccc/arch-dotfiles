# ==============================================================================
# ~/.zshrc - Entrypoint Loader
# ==============================================================================

# 1. Load environment secrets first if available (API keys, Tokens)
if [ -f "$HOME/.secrets.env" ]; then
  # Automatically export all variables defined in secrets.env
  set -a
  source "$HOME/.secrets.env"
  set +a
fi

# 2. Sequentially load modular configs from ~/.config/zsh/conf.d/*.zsh
ZSH_CONF_DIR="$HOME/.config/zsh/conf.d"

if [ -d "$ZSH_CONF_DIR" ]; then
  for conf in "$ZSH_CONF_DIR"/*.zsh; do
    [ -r "$conf" ] && source "$conf"
  done
  unset conf
fi
unset ZSH_CONF_DIR
